# Production Environment Configuration
# IMPORTANT: Replace all placeholder values with actual production credentials

# Database
DATABASE_URL="postgresql://user:password@production-db-host:5432/almonds?schema=public&sslmode=require"

# Application
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://app.almonds.io

# JWT Authentication
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_256_BITS
JWT_EXPIRES_IN=7d

# Email (SendGrid)
SENDGRID_API_KEY=SG.REPLACE_WITH_ACTUAL_SENDGRID_API_KEY
