FROM_NAME="Almonds Team"

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET
STRIPE_PRICE_ID_PRO=price_REPLACE_WITH_PRO_PRICE_ID
STRIPE_PRICE_ID_BUSINESS=price_REPLACE_WITH_BUSINESS_PRICE_ID

# Redis (Job queues & caching)
REDIS_HOST=production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_TLS=true

# AWS Credentials (for resource management)
