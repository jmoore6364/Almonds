# Almonds Backend - Staging Environment
# Copy this file to .env.staging and update with your staging credentials

# Application
NODE_ENV=staging
PORT=3000

# Database
DATABASE_URL="postgresql://almonds_staging:CHANGE_ME@staging-db.example.com:5432/almonds_staging?schema=public"

# Redis
REDIS_URL="redis://staging-redis.example.com:6379"

# JWT Authentication
JWT_SECRET="CHANGE_ME_GENERATE_WITH_crypto.randomBytes(32).toString('hex')"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_WITH_crypto.randomBytes(32).toString('hex')"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS
CORS_ORIGIN="https://staging.almonds.io"

# OAuth - Google (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://api-staging.almonds.io/api/v1/auth/google/callback"

# OAuth - GitHub (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="https://api-staging.almonds.io/api/v1/auth/github/callback"

# Email (SendGrid)
SENDGRID_API_KEY="CHANGE_ME"
FROM_EMAIL="noreply@staging.almonds.io"
FROM_NAME="Almonds Staging"
FRONTEND_URL="https://staging.almonds.io"

# Stripe (Use test mode)
STRIPE_SECRET_KEY="sk_test_CHANGE_ME"
STRIPE_PUBLISHABLE_KEY="pk_test_CHANGE_ME"
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_ME"

# Stripe Price IDs (Test Mode)
STRIPE_PRICE_PRO="price_test_pro_monthly"
STRIPE_PRICE_BUSINESS="price_test_business_monthly"
STRIPE_PRICE_ENTERPRISE="price_test_enterprise_monthly"

# Rate Limiting
THROTTLE_TTL=60000          # 1 minute in milliseconds
THROTTLE_LIMIT=100          # 100 requests per TTL

# Logging
LOG_LEVEL="debug"           # error, warn, log, debug, verbose

# Monitoring (Optional)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="staging"

# AWS (Optional)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Azure (Optional)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_OAUTH=true
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true

# Security
# Enable detailed error messages in staging
EXPOSE_ERROR_DETAILS=true

# Health Check
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=true
