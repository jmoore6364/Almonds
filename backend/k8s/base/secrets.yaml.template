#     --from-literal=aws-secret-access-key="..." \
#     --from-literal=azure-client-secret="..."

apiVersion: v1
kind: Secret
metadata:
  name: almonds-secrets
  labels:
    app: almonds-api
type: Opaque
stringData:
  # Database
  database-url: "postgresql://user:password@postgres:5432/almonds?schema=public&sslmode=require"

  # Redis
  redis-password: "CHANGE_ME"

  # JWT
  jwt-secret: "CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
  jwt-refresh-secret: "CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"

  # Encryption
  encryption-key: "CHANGE_ME_32_CHARACTERS_LONG_KEY"

  # Stripe
  stripe-secret-key: "sk_live_CHANGE_ME"
  stripe-webhook-secret: "whsec_CHANGE_ME"

  # SendGrid
  sendgrid-api-key: "SG.CHANGE_ME"

  # OAuth - Google
  google-client-id: "CHANGE_ME"
  google-client-secret: "CHANGE_ME"

  # OAuth - GitHub
  github-client-id: "CHANGE_ME"
  github-client-secret: "CHANGE_ME"

  # AWS Credentials
  aws-access-key-id: "CHANGE_ME"
  aws-secret-access-key: "CHANGE_ME"

  # Azure Credentials
  azure-tenant-id: "CHANGE_ME"
  azure-client-id: "CHANGE_ME"
  azure-client-secret: "CHANGE_ME"

  # GCP Credentials (JSON key file)
  gcp-service-account-key: |
    {
      "type": "service_account",
      "project_id": "CHANGE_ME",
      "private_key_id": "CHANGE_ME",
      "private_key": "CHANGE_ME",
      "client_email": "CHANGE_ME",
      "client_id": "CHANGE_ME"
    }

  # Sentry
  sentry-dsn: "https://CHANGE_ME@sentry.io/PROJECT_ID"
