# Example usage:
#   kubectl create secret generic almonds-secrets \
#     --from-literal=database-url="postgresql://..." \
#     --from-literal=redis-password="..." \
#     --from-literal=jwt-secret="..." \
#     --from-literal=encryption-key="..." \
#     --from-literal=stripe-secret-key="sk_live_..." \
#     --from-literal=stripe-webhook-secret="whsec_..." \
#     --from-literal=sendgrid-api-key="SG...." \
#     --from-literal=google-client-secret="..." \
#     --from-literal=github-client-secret="..." \
